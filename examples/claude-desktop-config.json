{
  "mcpServers": {
    "mailsure": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/TO/email-validation-tool/dist/index.js",
        "--transport",
        "stdio"
      ],
      "env": {
        "OPENVERIFY_TRANSPORT": "stdio",
        "OPENVERIFY_LOG_LEVEL": "info",
        "OPENVERIFY_SMTP_ENABLED": "false"
      }
    }
  }
}
