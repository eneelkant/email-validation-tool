# MailSure MCP configuration
# Product / website / MCP identity: MailSure / MailSure MCP / mailsure-api
# Env var names keep the OPENVERIFY_* prefix for compatibility with existing
# .env files, Docker Compose, and render.yaml — do not rename them casually.
# Copy to .env and adjust. Never commit real secrets.

# Transport: stdio | http | both
OPENVERIFY_TRANSPORT=stdio

# HTTP server (used when transport is http or both)
OPENVERIFY_HTTP_HOST=127.0.0.1
# Local/Docker default. On Render (and similar), platform PORT overrides this.
OPENVERIFY_HTTP_PORT=8787
OPENVERIFY_MCP_PATH=/mcp

# Bearer token for HTTP MCP. OPTIONAL only when OPENVERIFY_HTTP_HOST is loopback
# (127.0.0.1 / ::1 / localhost). REQUIRED for 0.0.0.0 or any non-loopback bind —
# the process refuses to start without a token in that case (fail-closed).
# Never commit a real token. Do not log this value.
# Note: the MailSure website API (/api/verify*) does not use this bearer token;
# it is browser-facing and protected by CORS allowlist + dedicated rate limits.
OPENVERIFY_HTTP_AUTH_TOKEN=

# Comma-separated allowed Host headers (DNS rebinding protection). Empty = allow localhost only.
# For a public API hostname, include that host (e.g. api.example.com).
OPENVERIFY_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated CORS origins (full origins with scheme — used by the cors middleware).
# Empty = no CORS headers (recommended for non-browser MCP clients).
# Hostnames are also derived automatically for the MCP Origin / DNS-rebinding guard.
# For MailSure on GitHub Pages, include the Pages origin (no path):
#   OPENVERIFY_CORS_ORIGINS=https://eneelkant.github.io
# For local static preview + local API, also include the preview origin, e.g.:
#   OPENVERIFY_CORS_ORIGINS=http://127.0.0.1:3000,https://eneelkant.github.io
OPENVERIFY_CORS_ORIGINS=

# Data directories
OPENVERIFY_DATA_DIR=./data/runtime
OPENVERIFY_DB_PATH=./data/runtime/openverify.sqlite
OPENVERIFY_DISPOSABLE_PATH=./data/disposable-domains.txt
OPENVERIFY_UPLOAD_DIR=./data/uploads
OPENVERIFY_OUTPUT_DIR=./data/runtime/output

# Validation
OPENVERIFY_DNS_TIMEOUT_MS=5000
OPENVERIFY_DNS_SERVERS=
OPENVERIFY_CONCURRENCY=8
OPENVERIFY_CACHE_TTL_SECONDS=86400
OPENVERIFY_DOMAIN_CACHE_TTL_SECONDS=86400
OPENVERIFY_MAX_BATCH_SIZE=500
# CSV streaming batch size (rows held in memory per batch). Capped at 1000.
OPENVERIFY_CSV_BATCH_SIZE=100
# Maximum accepted CSV file size in bytes (default 100 MiB). Not "unlimited".
OPENVERIFY_MAX_CSV_BYTES=104857600
OPENVERIFY_RATE_LIMIT_WINDOW_MS=60000
OPENVERIFY_RATE_LIMIT_MAX=120

# MailSure website API (verify-only REST for the static public/ site).
# Off by default. Does NOT expose MCP admin tools (clear_cache, jobs, disposable updates).
# GitHub Pages cannot run Node — host this process separately, then set
# public/js/config.js → API_BASE_URL to that origin (no trailing slash).
#
# Recommended local enablement:
#   OPENVERIFY_TRANSPORT=http
#   OPENVERIFY_HTTP_HOST=127.0.0.1
#   OPENVERIFY_WEBSITE_API_ENABLED=true
#   OPENVERIFY_CORS_ORIGINS=http://127.0.0.1:3000
#
# Recommended Pages + self-hosted API (or Render Blueprint — see docs/render-deploy.md):
#   OPENVERIFY_TRANSPORT=http
#   OPENVERIFY_HTTP_HOST=0.0.0.0          # requires OPENVERIFY_HTTP_AUTH_TOKEN
#   OPENVERIFY_WEBSITE_API_ENABLED=true
#   OPENVERIFY_CORS_ORIGINS=https://eneelkant.github.io
#   OPENVERIFY_ALLOWED_HOSTS=localhost,127.0.0.1,<your-api-host>
# Leave public/js/config.js API_BASE_URL empty until that host is real and /health works.
OPENVERIFY_WEBSITE_API_ENABLED=false
OPENVERIFY_WEBSITE_RATE_LIMIT_WINDOW_MS=60000
OPENVERIFY_WEBSITE_RATE_LIMIT_MAX=30
OPENVERIFY_WEBSITE_MAX_BATCH_SIZE=50

# SMTP diagnostics (disabled by default — never sends mail)
OPENVERIFY_SMTP_ENABLED=false
OPENVERIFY_SMTP_TIMEOUT_MS=5000
OPENVERIFY_SMTP_CONCURRENCY=2
OPENVERIFY_CATCH_ALL_ENABLED=false

# Logging: fatal|error|warn|info|debug|trace
OPENVERIFY_LOG_LEVEL=info
# When true, logs may include full email addresses (off by default)
OPENVERIFY_LOG_EMAILS=false

# Retention
OPENVERIFY_JOB_RETENTION_DAYS=30
